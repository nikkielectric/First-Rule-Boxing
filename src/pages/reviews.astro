---
// Utils
import { getImage } from "astro:assets";

// Components
import BaseLayout from "@layouts/BaseLayout.astro";
import Banner from "@components/Banner/Banner.astro";
import ReviewsSection from "@components/Reviews/Reviews.astro";
import CTA from "@components/CTA/CTASimple.astro";

// Images
import landingImage from "@assets/images/banners/generic.jpg";
const optimizedImage = await getImage({ src: landingImage, format: "webp" });
---

<BaseLayout
	title="Reviews"
	description="Reviews from First Rule Boxing Club members in Fort Worth, TX — group boxing, youth boxing, and personal training."
	heroImage={optimizedImage}
>
	<Banner
		title="Reviews"
		description="What our members are saying about training at First Rule Boxing Club."
		image={optimizedImage}
	/>
	<ReviewsSection showAll />
	<CTA />
</BaseLayout>
