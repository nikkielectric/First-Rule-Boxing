---
// Dynamic city/service-area page — /<city>/
// Generates one page per entry in src/data/cities.json
import { getImage, Picture } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";
import Banner from "@components/Banner/Banner.astro";
import CTASimple from "@components/CTA/CTASimple.astro";
import Reviews from "@components/Reviews/Reviews.astro";
import FAQ from "@components/FAQ/FAQ.astro";
import { BUSINESS, SITE } from "@data/client";
import { SERVICES } from "@data/services";
import { buildBreadcrumbSchema, buildFaqSchema } from "@js/serviceSchema.js";
import cities from "@data/cities.json";

// Static banner image registry — Astro requires statically analyzable imports
import bannerFortWorth from "@assets/images/banners/fort-worth.jpg";
import bannerKeller from "@assets/images/banners/keller.jpg";
import bannerSaginaw from "@assets/images/banners/saginaw.jpg";
import bannerHaslet from "@assets/images/banners/haslet.jpg";
import bannerRoanoke from "@assets/images/banners/roanoke.jpg";

const bannerImages: Record<string, ImageMetadata> = {
	"fort-worth": bannerFortWorth,
	"keller": bannerKeller,
	"saginaw": bannerSaginaw,
	"haslet": bannerHaslet,
	"roanoke": bannerRoanoke,
};

type Scenario = { title: string; description: string };

type City = {
	slug: string;
	name: string;
	state: string;
	isHomeBase?: boolean;
	isCounty?: boolean;
	banner: string;
	lead: string;
	body: string[];
	commonJobs?: string[];
	scenarios?: Scenario[];
	neighborhoods: string[];
};

export async function getStaticPaths() {
	return (cities as City[]).map((city) => ({
		params: { city: city.slug },
		props: { city },
	}));
}

const { city } = Astro.props as { city: City };
const bannerImage = bannerImages[city.banner] ?? bannerFortWorth;
const optimizedBanner = await getImage({ src: bannerImage, format: "webp" });

const pageTitle = city.isHomeBase
	? `Boxing Gym in ${city.name}, ${city.state}`
	: `Boxing Classes for ${city.name}, ${city.state} Members`;

const seoDescription = `${BUSINESS.name} trains members from ${city.name}, ${city.state} — group boxing, youth boxing, personal training, and self-defense at our north Fort Worth gym.`;

const cityFaq = {
	title: `${city.name} Boxing FAQs`,
	questions: [
		{
			question: city.isHomeBase
				? `Where exactly is First Rule Boxing Club in ${city.name}?`
				: `How far is First Rule Boxing Club from ${city.name}?`,
			answer: city.isHomeBase
				? `We're at 10027 Harmon Rd Suite 127, off the Harmon Rd / I-35W corridor in north Fort Worth.`
				: `We're a short, reasonable drive from most of ${city.name} — close enough that members make it a regular part of the week, not a special trip.`,
		},
		{
			question: `Do I need experience to start?`,
			answer: `No. Most members start with zero boxing experience. Group classes are coached at a pace that works for beginners.`,
		},
		{
			question: `What are your hours?`,
			answer: `Monday through Thursday, with an early-morning block (6:00–7:00 AM) and an evening block (6:00–8:00 PM). Closed Friday through Sunday.`,
		},
		{
			question: `Do you offer classes for kids?`,
			answer: `Yes — youth boxing is built for kids and teens, with class pace and contact level adjusted by age and experience.`,
		},
		{
			question: `Is there a contract to join?`,
			answer: `No long-term contract is required to try a class. Call, text, or message us and we'll get you scheduled.`,
		},
		{
			question: `Do you offer self-defense classes?`,
			answer: `Yes — one-on-one or small-group self-defense training built for women, professionals, and complete beginners.`,
		},
		{
			question: `Can I just use the gym without taking a class?`,
			answer: `Yes. Open gym membership gives you access to the heavy bags, mitts, and training floor outside of class hours.`,
		},
	],
};

const breadcrumbSchema = buildBreadcrumbSchema([
	{ name: "Home", url: "/" },
	{ name: "Service Areas", url: "/fort-worth/" },
	{ name: `${city.name}, ${city.state}`, url: `/${city.slug}/` },
]);
const faqSchema = buildFaqSchema(cityFaq.questions);

const localBusinessForCity = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"name": `${BUSINESS.name} — Serving ${city.name}, ${city.state}`,
	"description": seoDescription,
	"url": `${SITE.url}/${city.slug}/`,
	"telephone": BUSINESS.phoneForTel,
	"email": BUSINESS.email,
	"address": {
		"@type": "PostalAddress",
		"streetAddress": BUSINESS.address.lineOne,
		"addressLocality": BUSINESS.address.city,
		"addressRegion": BUSINESS.address.state,
		"postalCode": BUSINESS.address.zip,
	},
	"areaServed": {
		"@type": "City",
		"name": `${city.name}, ${city.state}`,
	},
};
---

<BaseLayout
	title={pageTitle}
	description={seoDescription}
	heroImage={optimizedBanner}
>
	<Fragment slot="schema">
		<script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessForCity)} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	</Fragment>

	<Banner
		title={`${city.name}, ${city.state}`}
		description={city.lead}
		image={optimizedBanner}
	/>

	<!-- Intro -->
	<section id="city-intro">
		<div class="cs-container">
			<span class="cs-topper">Service Area</span>
			<h2 class="cs-title">
				Boxing Training for <span class="cs-title-highlight">{city.name}, {city.state}</span>
			</h2>
			{city.body.map((p) => <p class="cs-text">{p}</p>)}
			{city.neighborhoods?.length > 0 && (
				<>
					<h3 class="cs-h3">Areas we draw members from</h3>
					<ul class="cs-neighborhood-list">
						{city.neighborhoods.map((n) => <li>{n}</li>)}
					</ul>
				</>
			)}
			<a href={BUSINESS.bookingUrl} target="_blank" rel="noopener" class="cs-button-solid">Get Started From {city.name}</a>
		</div>
	</section>

	<!-- What we do -->
	{city.commonJobs && city.commonJobs.length > 0 && (
		<section id="city-haul-list">
			<div class="cs-container">
				<div class="cs-content">
					<span class="cs-topper">What We Do</span>
					<h2 class="cs-title">Programs {city.name} members train in</h2>
					<p class="cs-text">
						These are the programs {city.name} members train in most. If you're not sure which fits, ask — we'll help you figure it out.
					</p>
				</div>
				<ul class="cs-haul-list">
					{city.commonJobs.map((item) => (
						<li class="cs-haul-item">{item}</li>
					))}
				</ul>
			</div>
		</section>
	)}

	<!-- What training looks like -->
	{city.scenarios && city.scenarios.length > 0 && (
		<section id="city-scenarios">
			<div class="cs-container">
				<div class="cs-content">
					<span class="cs-topper">Getting Started</span>
					<h2 class="cs-title">What training looks like for {city.name} members</h2>
					<p class="cs-text">
						A few common starting points for {city.name} members — the same approach we'd take with you.
					</p>
				</div>
				<div class="cs-scenario-grid">
					{city.scenarios.map((s) => (
						<article class="cs-scenario">
							<h3 class="cs-scenario-title">{s.title}</h3>
							<p class="cs-scenario-text">{s.description}</p>
						</article>
					))}
				</div>
			</div>
		</section>
	)}

	<!-- Services grid -->
	<section id="city-services">
		<div class="cs-container">
			<div class="cs-content">
				<span class="cs-topper">Programs for {city.name}</span>
				<h2 class="cs-title">Everything we offer</h2>
				<p class="cs-text">
					Six programs, one gym. From a first group class to 1-on-1 coaching, youth boxing, and self-defense.
				</p>
			</div>
			<ul class="cs-card-group">
				{SERVICES.map((s) => (
					<li class="cs-item">
						<a href={s.href} class="cs-link">
							<h3 class="cs-h3">{s.title}</h3>
							<p class="cs-item-text">{s.tagline}</p>
						</a>
						<Picture
							src={s.image}
							alt={s.title}
							widths={[400, 800]}
							sizes="(min-width: 48rem) 33vw, 100vw"
							formats={["avif", "webp"]}
							pictureAttributes={{ class: "cs-item-background" }}
							loading="lazy"
						/>
					</li>
				))}
			</ul>
		</div>
	</section>

	<CTASimple />
	<Reviews />
	<FAQ {...cityFaq} />
</BaseLayout>

<style lang="less">
	#city-intro {
		padding: var(--sectionPadding);
		background-color: #fff;

		.cs-container {
			width: 100%;
			max-width: (1100/16rem);
			margin: auto;
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			gap: (16/16rem);
		}

		.cs-topper {
			color: var(--primary);
		}

		.cs-title {
			font-size: clamp(2rem, 4vw, 3rem);
			font-family: var(--headerFont);
			font-weight: 700;
			text-transform: uppercase;
			line-height: 1.2em;
			margin: 0 0 (16/16rem) 0;
			color: var(--headerColor);
		}

		.cs-title-highlight {
			color: var(--primary);
		}

		.cs-text {
			font-size: var(--bodyFontSize);
			line-height: 1.5em;
			color: var(--bodyTextColor);
			margin: 0;
		}

		.cs-h3 {
			margin-top: (24/16rem);
			color: var(--headerColor);
		}

		.cs-neighborhood-list {
			list-style: none;
			padding: 0;
			margin: 0;
			display: flex;
			flex-wrap: wrap;
			gap: (8/16rem) (16/16rem);

			li {
				font-size: (16/16rem);
				line-height: 1.5em;
				color: var(--bodyTextColor);
				padding: (4/16rem) (12/16rem);
				background-color: var(--bgLight);
				border: 1px solid #e3e6e1;
				border-radius: (4/16rem);
			}
		}

		.cs-button-solid {
			margin-top: (24/16rem);
		}
	}

	#city-haul-list {
		padding: var(--sectionPadding);
		background-color: var(--bgLight);

		.cs-container {
			width: 100%;
			max-width: (1100/16rem);
			margin: auto;
			display: flex;
			flex-direction: column;
			gap: clamp(2rem, 4vw, 3rem);
		}

		.cs-content {
			max-width: (740/16rem);
		}

		.cs-topper {
			color: var(--primary);
		}

		.cs-title {
			font-size: clamp(1.75rem, 3.5vw, 2.5rem);
			font-family: var(--headerFont);
			font-weight: 700;
			text-transform: uppercase;
			line-height: 1.2em;
			margin: (8/16rem) 0 (16/16rem) 0;
			color: var(--headerColor);
		}

		.cs-text {
			font-size: var(--bodyFontSize);
			line-height: 1.5em;
			color: var(--bodyTextColor);
			margin: 0;
		}

		.cs-haul-list {
			list-style: none;
			padding: 0;
			margin: 0;
			display: grid;
			grid-template-columns: 1fr;
			gap: (12/16rem);
		}

		.cs-haul-item {
			padding: (16/16rem) (20/16rem);
			background-color: #fff;
			border-left: 4px solid var(--primary);
			color: var(--bodyTextColor);
			font-size: (16/16rem);
			line-height: 1.5em;
		}
	}

	@media (min-width: 48rem) {
		#city-haul-list .cs-haul-list {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	#city-scenarios {
		padding: var(--sectionPadding);
		background-color: #fff;

		.cs-container {
			width: 100%;
			max-width: (1280/16rem);
			margin: auto;
			display: flex;
			flex-direction: column;
			gap: clamp(2rem, 4vw, 3rem);
		}

		.cs-content {
			max-width: (740/16rem);
		}

		.cs-topper {
			color: var(--primary);
		}

		.cs-title {
			font-size: clamp(1.75rem, 3.5vw, 2.5rem);
			font-family: var(--headerFont);
			font-weight: 700;
			text-transform: uppercase;
			line-height: 1.2em;
			margin: (8/16rem) 0 (16/16rem) 0;
			color: var(--headerColor);
		}

		.cs-text {
			font-size: var(--bodyFontSize);
			line-height: 1.5em;
			color: var(--bodyTextColor);
			margin: 0;
		}

		.cs-scenario-grid {
			display: grid;
			grid-template-columns: 1fr;
			gap: (20/16rem);
		}

		.cs-scenario {
			padding: clamp(1.25rem, 3vw, 2rem);
			background-color: var(--bgLight);
			border-top: 4px solid var(--primary);
		}

		.cs-scenario-title {
			font-size: (20/16rem);
			font-family: var(--headerFont);
			font-weight: 700;
			text-transform: uppercase;
			line-height: 1.3em;
			margin: 0 0 (12/16rem) 0;
			color: var(--headerColor);
		}

		.cs-scenario-text {
			font-size: (16/16rem);
			line-height: 1.55em;
			margin: 0;
			color: var(--bodyTextColor);
		}
	}

	@media (min-width: 48rem) {
		#city-scenarios .cs-scenario-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	#city-services {
		padding: var(--sectionPadding);
		background-color: var(--bgLight);
		position: relative;
		z-index: 10;

		.cs-container {
			width: 100%;
			max-width: (1280/16rem);
			margin: auto;
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: clamp(3rem, 6vw, 4rem);
		}

		.cs-content {
			text-align: center;
			width: 100%;
			max-width: (740/16rem);
			display: flex;
			flex-direction: column;
			align-items: center;
		}

		.cs-card-group {
			margin: 0;
			padding: 0;
			width: 100%;
			display: grid;
			grid-template-columns: repeat(12, 1fr);
			gap: clamp(1rem, 2.5vw, 1.25rem);
		}

		.cs-item {
			width: 100%;
			text-align: left;
			list-style: none;
			margin: 0;
			padding: 0;
			background-color: #000;
			overflow: hidden;
			box-shadow: 0 4px 14px 0 rgba(0, 0, 0, 0.1);
			box-sizing: border-box;
			grid-column: span 12;
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			justify-content: flex-end;
			position: relative;
			z-index: 1;

			&:hover {
				.cs-item-background img {
					opacity: 0.4;
					transform: scale(1.1);
				}
				.cs-h3 {
					color: var(--primary);
				}
			}
		}

		.cs-link {
			text-decoration: none;
			padding: clamp(7rem, 16vw, 11rem) (24/16rem) (24/16rem);
		}

		.cs-h3 {
			font-size: clamp(1.125rem, 2vw, 1.4rem);
			line-height: 1.2em;
			font-weight: bold;
			margin: 0 0 (8/16rem) 0;
			color: var(--bodyTextColorWhite);
			transition: color 0.3s;
		}

		.cs-item-text {
			font-size: clamp(0.875rem, 1.5vw, 1rem);
			line-height: 1.5em;
			margin: 0;
			color: var(--bodyTextColorWhite);
			opacity: 0.9;
		}

		.cs-item-background {
			width: 100%;
			height: 100%;
			display: block;
			position: absolute;
			top: 0;
			left: 0;
			z-index: -1;

			&:before {
				content: "";
				position: absolute;
				display: block;
				height: 100%;
				width: 100%;
				background: var(--headerColor);
				opacity: 0.3;
				top: 0;
				left: 0;
				z-index: 1;
			}

			&:after {
				content: "";
				position: absolute;
				display: block;
				height: 100%;
				width: 100%;
				background: linear-gradient(to bottom, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
				opacity: 0.5;
				bottom: 0;
				left: 0;
				z-index: 2;
			}

			img {
				position: absolute;
				top: 0;
				left: 0;
				height: 100%;
				width: 100%;
				object-fit: cover;
				transition: transform 0.6s, opacity 0.3s;
			}
		}
	}

	@media only screen and (min-width: 48rem) {
		#city-services .cs-item {
			grid-column: span 6;
		}
	}

	@media only screen and (min-width: 64rem) {
		#city-services .cs-item {
			grid-column: span 4;
		}
	}

	/* Dark mode */
	body.dark-mode {
		#city-intro {
			background-color: var(--dark);
			.cs-title,
			.cs-h3 {
				color: var(--bodyTextColorWhite);
			}
			.cs-text {
				color: var(--bodyTextColorWhite);
				opacity: 0.85;
			}
			.cs-neighborhood-list li {
				background-color: rgba(255, 255, 255, 0.05);
				border-color: rgba(255, 255, 255, 0.1);
				color: var(--bodyTextColorWhite);
			}
		}
		#city-haul-list {
			background-color: rgba(0, 0, 0, 0.3);
			.cs-title { color: var(--bodyTextColorWhite); }
			.cs-text { color: var(--bodyTextColorWhite); opacity: 0.85; }
			.cs-haul-item {
				background-color: var(--medium);
				color: var(--bodyTextColorWhite);
			}
		}
		#city-scenarios {
			background-color: var(--dark);
			.cs-title { color: var(--bodyTextColorWhite); }
			.cs-text { color: var(--bodyTextColorWhite); opacity: 0.85; }
			.cs-scenario {
				background-color: var(--medium);
			}
			.cs-scenario-title { color: var(--bodyTextColorWhite); }
			.cs-scenario-text { color: var(--bodyTextColorWhite); opacity: 0.85; }
		}
		#city-services {
			background-color: rgba(0, 0, 0, 0.3);
			.cs-title,
			.cs-text {
				color: var(--bodyTextColorWhite);
			}
			.cs-text { opacity: 0.85; }
		}
	}
</style>
