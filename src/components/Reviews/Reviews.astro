---
// Utils
import { Icon } from "astro-icon/components";
import { BUSINESS } from "@data/client";

// Real 5-star reviews from First Rule Boxing Club's Google Business Profile.
// Long reviews are trimmed (cuts marked with …); wording is the reviewer's own,
// with spelling tidied and the gym's old name swapped for [First Rule Boxing Club].
// The first 4 show on every page; /reviews/ shows all.
const reviews = [
  {
    title: "Judgment-Free From Day One",
    body: "Coach Malaki was super welcoming on my first day and took the time to walk me through the basics and building blocks of boxing… It's truly a judgment-free environment with people of all ages, sizes, and fitness levels. You never feel out of place or in the spotlight, even if you're brand new.",
    name: "Annie F.",
    location: "Group Boxing Member",
  },
  {
    title: "Training Together For Three Years",
    body: "My son (now 15) and I have been training with Coach Malaki for over three years… Three years ago, I would be completely exhausted after about 20 minutes of training. Today, when the final bell rings at the end of class, I often find myself wanting more.",
    name: "Vijay J.",
    location: "Member & Parent",
  },
  {
    title: "Workouts Adapted To My Needs",
    body: "[First Rule Boxing Club] has truly changed my life! As a full-time wheelchair user sometimes it can be really easy to feel excluded. But not here! Since day one the amazing staff have made sure that I feel welcome and have adapted the workouts to specifically fit my needs and abilities. I will forever be grateful!",
    name: "Cash C.",
    location: "Member",
  },
  {
    title: "Changed Her Outlook On Life",
    body: "Changed my teenage daughter's outlook on life. Excellent coaches, always made her feel comfortable.",
    name: "Jessie H.",
    location: "Youth Boxing Parent",
  },
  {
    title: "One Of The Best Things I've Done",
    body: "Coach is an excellent instructor, and is always concerned with the safety and progress of all his students… I've been a student for a couple of years and it's one of the best things I've ever done for myself.",
    name: "David R.",
    location: "Member",
  },
  {
    title: "It Feels Like A Family",
    body: "The coaches actually pay attention to all of their students… A lot of combat gyms, when you walk in, it feels intimidating… Here it feels like a family. Coach Malaki introduces you to other people at the gym. It isn't just about boxing. It's about learning, and growing.",
    name: "Joel O.",
    location: "Member",
  },
  {
    title: "Genuine, Individualized Care",
    body: "We have been with Coach Malaki for a few years now as the trainer for our grandson with special needs… The club's program is holistic in nature and has addressed both physical, emotional, and social aspects of [his] developing needs. We HIGHLY recommend them!!",
    name: "Debra S.",
    location: "Youth Boxing Grandparent",
  },
  {
    title: "They Genuinely Care About The Kids",
    body: "The coaches here are incredible—not only do they have a deep, high-level knowledge of the sport, but their passion for teaching shows in every single session… They don't just teach technical boxing skills; they build confidence, discipline, and character.",
    name: "Leilani A.",
    location: "Google Review",
  },
];

const { showAll = false } = Astro.props;
const shownReviews = showAll ? reviews : reviews.slice(0, 4);

const reviewLink = BUSINESS.socials.googleBusiness || "/contact/";
---

<section id="reviews-2290">
  <div class="cs-container">
    <div class="cs-content">
      <span class="cs-topper">5-Star Reviews</span>
      <h2 class="cs-title">What Our Members Say</h2>
    </div>
    <ul class="cs-card-group">
      {
        shownReviews.map((review) => (
          <li class="cs-item">
            <Icon
              name="quote"
              class="cs-quote"
              width="40"
              height="38"
              aria-hidden="true"
            />
            <h3 class="cs-header">{review.title}</h3>
            <p class="cs-item-text">{review.body}</p>
            <div class="cs-flex-group">
              <span class="cs-name">
                {review.name}
                <span class="cs-job">{review.location}</span>
              </span>
            </div>
          </li>
        ))
      }
    </ul>
    <a class="cs-button-solid" href={reviewLink} target="_blank" rel="noopener">
      Read More on Google
    </a>
  </div>
</section>

<style lang="less">
  /*-- -------------------------- -->
<---        Reviews 2290        -->
<--- -------------------------- -*/

  @media only screen and (min-width: 0px) {
    #reviews-2290 {
      text-align: center;
      padding: var(--sectionPadding);
      overflow: hidden;
      position: relative;
      z-index: 1;
      background-color: #ebebeb;

      .cs-container {
        width: 100%;
        max-width: (824/16rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        text-align: center;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .cs-title {
        font-family: var(--headerFont);
        font-size: clamp(1.9375rem, 3.9vw, (49/16rem));
        font-weight: 600;
        line-height: 1.2em;
        letter-spacing: 1px;
        text-transform: uppercase;
        max-width: 20ch;
        margin: 0;
        color: var(--headerColor);
      }

      .cs-card-group {
        width: 100%;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: clamp(0.5rem, 2vw, 1.25rem);
      }

      .cs-item {
        text-align: left;
        list-style: none;
        box-sizing: border-box;
        padding: clamp(1rem, 2vw, 2rem);
        background-color: #fff;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        grid-column: span 12;
        gap: clamp(1rem, 3vw, 1.5rem);
        position: relative;
        z-index: 1;
        transition:
          transform 0.3s,
          box-shadow 0.3s,
          border-color 0.3s;
        border-bottom: 4px solid transparent;

        &:hover {
          transform: translateY(-0.5rem);
          box-shadow: 0px 4px 24px 0px rgba(0, 0, 0, 0.25);
          border-bottom-color: var(--primary);

          .cs-quote {
            color: var(--primary);
          }
        }
      }

      .cs-quote {
        width: (40/16rem);
        height: auto;
        display: block;
        color: var(--primary);
        transition: color 0.3s;
      }

      .cs-header {
        font-family: var(--headerFont);
        font-size: (20/16rem);
        font-weight: 600;
        line-height: 1.2em;
        text-transform: uppercase;
        margin: 0;
        padding-bottom: clamp(1rem, 3vw, 1.5rem);
        color: var(--headerColor);
        border-bottom: 1px solid #e7e7e8;
      }

      .cs-item-text {
        font-family: var(--bodyFont);
        font-size: (16/16rem);
        line-height: 1.5em;
        margin: 0;
        color: #585b5d;
      }

      .cs-flex-group {
        margin-top: auto;
        display: flex;
        justify-content: flex-start;
        align-items: center;
        gap: clamp(0.8rem, 1.5vw, 1rem);
      }

      .cs-name {
        font-family: var(--bodyFont);
        font-size: (16/16rem);
        font-weight: 700;
        line-height: 1.5em;
        margin: 0;
        color: var(--headerColor);
        display: block;
      }

      .cs-job {
        font-family: var(--bodyFont);
        font-size: (16/16rem);
        font-weight: 400;
        line-height: 1.5em;
        margin: 0;
        color: var(--secondary);
        display: block;
      }
    }
  }

  @media only screen and (min-width: 48rem) {
    #reviews-2290 {
      .cs-item {
        grid-column: span 6;
      }
    }
  }

  @media only screen and (min-width: 81.25rem) {
    #reviews-2290 {
      .cs-container {
        max-width: (1280/16rem);
      }

      .cs-item {
        grid-column: span 3;
      }
    }
  }

  @media only screen and (min-width: 0em) {
    body.dark-mode {
      #reviews-2290 {
        background-color: var(--dark);

        .cs-title,
        .cs-header,
        .cs-name {
          color: var(--bodyTextColorWhite);
        }

        .cs-item {
          background-color: var(--medium);
        }

        .cs-item-text {
          color: var(--bodyTextColorWhite);
          opacity: 0.85;
        }

        .cs-header {
          border-bottom-color: rgba(255, 255, 255, 0.1);
        }

        .cs-job {
          color: var(--primaryLight);
        }

        .cs-quote {
          color: var(--primaryLight);
        }

        .cs-item:hover .cs-quote {
          color: var(--primary);
        }

        .cs-item:hover {
          border-bottom-color: var(--primary);
          box-shadow: 0px 4px 24px 0px rgba(0, 0, 0, 0.5);
        }
      }
    }
  }
</style>
