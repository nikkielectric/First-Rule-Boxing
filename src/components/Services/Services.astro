---
import { Picture } from "astro:assets";
import { SERVICES } from "@data/services";
---

<!-- ============================================ --><!--                    Services                  --><!-- ============================================ -->
<section id="services-1253">
  <div class="cs-container">
    <div class="cs-content">
      <div class="cs-flex-group">
        <span class="cs-topper">What We Do</span>
        <h2 class="cs-title">Six programs. One gym.</h2>
      </div>
      <p class="cs-text">
        From a first group class to one-on-one coaching, youth boxing, and
        self-defense — First Rule Boxing Club has a program for every goal
        and every skill level. Pick one and show up.
      </p>
    </div>
    <ul class="cs-card-group">
      {
        SERVICES.map((service) => (
          <li class="cs-item">
            <a href={service.href} class="cs-link">
              <h3 class="cs-h3">{service.title}</h3>
              <p class="cs-item-text">{service.tagline}</p>
            </a>
            <Picture
              src={service.image}
              alt={service.title}
              widths={[413, 826]}
              sizes="(min-width: 601px) 413px, 100vw"
              formats={["avif", "webp"]}
              pictureAttributes={{ class: "cs-item-background" }}
              loading="lazy"
              decoding="async"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style lang="less">
  /*-- -------------------------- -->
<---          Services          -->
<--- -------------------------- -*/

  @media only screen and (min-width: 0rem) {
    #services-1253 {
      padding: var(--sectionPadding);
      position: relative;
      z-index: 10;

      .cs-container {
        width: 100%;
        max-width: (1280/16rem);
        margin: auto;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        text-align: left;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
      }

      .cs-title {
        max-width: 28ch;
      }

      .cs-card-group {
        margin: 0;
        padding: 0;
        width: 100%;
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: clamp(1rem, 2.5vw, 1.25rem);
      }

      .cs-item {
        width: 100%;
        text-align: left;
        list-style: none;
        margin: 0;
        padding: 0;
        background-color: #000;
        overflow: hidden;
        box-shadow: 0 4px 14px 0 rgba(0, 0, 0, 0.05);
        box-sizing: border-box;
        grid-column: span 12;
        grid-row: span 1;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: flex-end;
        position: relative;
        z-index: 1;

        &:hover {
          .cs-item-background {
            img {
              opacity: 0.4;
              transform: scale(1.3);
            }
          }

          .cs-h3 {
            color: var(--primary);
          }
        }

        &:before {
          content: "";
          width: 100%;
          height: 100%;
          border: 1px solid rgba(255, 255, 255, 0.4);
          box-sizing: border-box;
          pointer-events: none;
          opacity: 1;
          position: absolute;
          display: block;
          top: 0;
          left: 0;
          z-index: 10;
        }
      }

      .cs-link {
        text-decoration: none;
        padding: clamp(7.8125rem, 19vw, 14.75rem) (24/16rem) (24/16rem);
      }

      .cs-h3 {
        font-size: clamp(1.25rem, 2.5vw, 1.5625rem);
        line-height: 1.2em;
        font-weight: bold;
        margin: 0 0 (12/16rem) 0;
        color: var(--bodyTextColorWhite);
        transition: color 0.3s;
      }

      .cs-item-text {
        font-size: clamp(0.875rem, 1.5vw, 1rem);
        line-height: 1.5em;
        max-width: (450/16rem);
        margin: 0;
        color: var(--bodyTextColorWhite);
        opacity: 0.9;
      }

      .cs-item-background {
        width: 100%;
        height: 100%;
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;

        &:before {
          content: "";
          position: absolute;
          display: block;
          height: 100%;
          width: 100%;
          background: var(--headerColor);
          opacity: 0.3;
          top: 0;
          left: 0;
          z-index: 1;
        }

        &:after {
          content: "";
          position: absolute;
          display: block;
          height: 100%;
          width: 100%;
          background: linear-gradient(to bottom, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
          opacity: 0.5;
          bottom: 0;
          left: 0;
          z-index: 2;
        }

        img {
          position: absolute;
          top: 0;
          left: 0;
          height: 100%;
          width: 100%;
          object-fit: cover;
          transition: transform 0.6s, opacity 0.3s;
        }
      }
    }
  }

  @media only screen and (min-width: 48rem) {
    #services-1253 {
      .cs-content {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        gap: (48/16rem);
      }

      .cs-title {
        margin: 0;
      }

      .cs-flex-group {
        width: 50%;
      }

      .cs-item {
        grid-column: span 6;
      }
    }
  }

  @media only screen and (min-width: 64rem) {
    #services-1253 .cs-item {
      grid-column: span 3;
    }

    #services-1253 .cs-link {
      padding: clamp(6rem, 14vw, 11rem) (20/16rem) (20/16rem);
    }
  }

  @media only screen and (min-width: 0rem) {
    body.dark-mode {
      #services-1253 {
        .cs-title,
        .cs-text {
          color: var(--bodyTextColorWhite);
        }

        .cs-text {
          opacity: 0.8;
        }
      }
    }
  }
</style>
