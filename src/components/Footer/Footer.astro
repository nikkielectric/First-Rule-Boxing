---
// Utils
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { getCurrentYear } from "@js/utils";

// Data
import { BUSINESS } from "@data/client";

// Assets
import navLogo from "@assets/images/nav-logo.png";

const currentYear = getCurrentYear();

const quickLinks = [
  { label: "About", href: "/about/" },
  { label: "Service Areas", href: "/fort-worth/" },
  { label: "Reviews", href: "/reviews/" },
  { label: "Contact", href: "/contact/" },
];

const services = [
  { label: "Group Boxing Classes", href: "/services/group-boxing-classes/" },
  { label: "Youth Boxing", href: "/services/youth-boxing/" },
  { label: "1-on-1 Personal Training", href: "/services/personal-training/" },
  { label: "Self-Defense Training", href: "/services/self-defense/" },
  { label: "STRONG by Zumba", href: "/services/strong-by-zumba/" },
  { label: "Open Gym Membership", href: "/services/open-gym-membership/" },
];

const socialLinks = [
  { key: "facebook", label: "Follow us on Facebook", href: BUSINESS.socials.facebook },
  { key: "instagram", label: "Follow us on Instagram", href: BUSINESS.socials.instagram },
].filter((s) => s.href);
---

<footer id="cs-footer-1110">
  <div class="cs-container">
    <!-- Brand -->
    <div class="cs-brand">
      <a href="/" class="cs-brand-logo" aria-label="First Rule Boxing Club home">
        <Image src={navLogo} alt="First Rule Boxing Club" width={160} height={160} />
      </a>
      <p class="cs-brand-text">
        A coached, family-oriented boxing gym in north Fort Worth, TX — group
        classes, personal training, youth boxing, and self-defense, all under
        one roof.
      </p>
      <ul class="cs-nav cs-contact-list">
        <li class="cs-nav-li">
          <Icon
            class="cs-icon"
            name="footer-phone"
            width="24"
            height="24"
            aria-hidden="true"
          />
          <a class="cs-nav-link cs-phone" href={`tel:${BUSINESS.phoneForTel}`}
            >{BUSINESS.phoneFormatted}</a
          >
        </li>
        <li class="cs-nav-li">
          <Icon
            class="cs-icon"
            name="footer-mail"
            width="24"
            height="24"
            aria-hidden="true"
          />
          <a class="cs-nav-link cs-email" href={`mailto:${BUSINESS.email}`}
            >{BUSINESS.email}</a
          >
        </li>
        <li class="cs-nav-li">
          <Icon
            class="cs-icon"
            name="footer-pin"
            width="24"
            height="24"
            aria-hidden="true"
          />
          <a
            class="cs-nav-link cs-address"
            href={BUSINESS.address.mapLink}
            target="_blank"
            rel="noopener"
          >
            {BUSINESS.address.lineOne}<br />{BUSINESS.address.city}, {
              BUSINESS.address.state
            }
            {BUSINESS.address.zip}
          </a>
        </li>
      </ul>
      {
        socialLinks.length > 0 && (
          <ul class="cs-social-list">
            {socialLinks.map((s) => (
              <li>
                <a
                  class="cs-social-link"
                  href={s.href}
                  target="_blank"
                  rel="noopener"
                  aria-label={s.label}
                >
                  {s.key === "facebook" && (
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M22 12.06C22 6.48 17.52 2 11.94 2 6.36 2 1.88 6.48 1.88 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.42V9.91c0-2.39 1.42-3.71 3.6-3.71 1.04 0 2.13.19 2.13.19v2.34h-1.2c-1.18 0-1.55.74-1.55 1.49v1.79h2.64l-.42 2.91h-2.22V22c4.78-.76 8.44-4.92 8.44-9.94Z" />
                    </svg>
                  )}
                  {s.key === "instagram" && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      aria-hidden="true"
                    >
                      <rect x="3" y="3" width="18" height="18" rx="5" />
                      <circle cx="12" cy="12" r="4" />
                      <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                    </svg>
                  )}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    <!-- Quick Links -->
    <ul class="cs-nav">
      <li class="cs-nav-li">
        <span class="cs-header">Quick Links</span>
      </li>
      {
        quickLinks.map((link) => (
          <li class="cs-nav-li">
            <a class="cs-nav-link" href={link.href}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <!-- Programs -->
    <ul class="cs-nav">
      <li class="cs-nav-li">
        <span class="cs-header">Programs</span>
      </li>
      {
        services.map((service) => (
          <li class="cs-nav-li">
            <a class="cs-nav-link" href={service.href}>
              {service.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="cs-bottom">
    <span class="cs-copyright"
      >© Copyright {currentYear} - {BUSINESS.name}</span
    >
    <span class="cs-copyright">
      Website Built By{" "}
      <a
        class="cs-copyright-link"
        href="https://www.wisdomstudios.co"
        target="_blank"
        rel="noopener">Wisdom Studios</a
      >
    </span>
  </div>
</footer>

<style lang="less">
  /*-- -------------------------- -->
<---          Footer            -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #cs-footer-1110 {
      padding: var(--sectionPadding);
      /* Near-black brand footer with subtle vignette */
      background:
        linear-gradient(
          -73.74deg,
          rgba(0, 0, 0, 0) 8.97%,
          rgba(0, 0, 0, 0.5) 83.86%
        ),
        var(--headerColor);
      position: relative;
      z-index: 10;

      .cs-container {
        width: 100%;
        /* reset on desktop */
        max-width: (700/16rem);
        margin: auto;
        display: flex;
        justify-content: flex-start;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: (40/16rem);
      }

      /* Brand column */
      .cs-brand {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: (16/16rem);
      }

      .cs-brand-logo {
        display: block;
        height: (56/16rem);

        img {
          height: 100%;
          width: auto;
          object-fit: contain;
        }
      }

      .cs-brand-text {
        font-size: (16/16rem);
        line-height: 1.5em;
        max-width: (320/16rem);
        margin: 0;
        color: #f7f7f7;
        opacity: 0.85;
        font-family: var(--bodyFont);
      }

      .cs-contact-list {
        gap: (10/16rem);
      }

      .cs-social-list {
        margin: 0;
        padding: 0;
        display: flex;
        align-items: center;
        gap: (14/16rem);
      }

      .cs-social-link {
        width: (22/16rem);
        height: (22/16rem);
        display: flex;
        justify-content: center;
        align-items: center;
        color: #f7f7f7;
        transition: color 0.3s, transform 0.3s;

        svg {
          width: 100%;
          height: 100%;
          display: block;
        }

        &:hover {
          color: var(--primary);
          transform: translateY(-2px);
        }
      }

      /* Navigation Links */
      .cs-nav {
        width: 100%;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        gap: (12/16rem);
      }

      .cs-nav-li {
        list-style: none;
        display: flex;
        justify-content: flex-start;
        align-items: flex-start;
      }

      .cs-header {
        font-size: (20/16rem);
        font-weight: 600;
        line-height: 1.2em;
        text-transform: uppercase;
        margin-bottom: (12/16rem);
        color: #f7f7f7;
        font-family: var(--headerFont);
        display: block;
        position: relative;
      }

      .cs-nav-link {
        font-size: (16/16rem);
        line-height: 1.5em;
        text-decoration: none;
        color: #f7f7f7;
        font-family: var(--bodyFont);
        display: inline-block;
        position: relative;
        transition: color 0.3s;

        &:before {
          /* underline */
          content: "";
          width: 0%;
          height: (2/16rem);
          background: currentColor;
          opacity: 1;
          display: block;
          position: absolute;
          bottom: (-2/16rem);
          left: 0;
          transition: width 0.3s;
        }

        &:hover {
          color: var(--primary);
          &:before {
            width: 100%;
          }
        }
      }

      .cs-icon {
        width: (24/16rem);
        height: (24/16rem);
        margin-right: (12/16rem);
        color: #f7f7f7;
        flex-shrink: 0;
      }

      .cs-bottom {
        max-width: (1280/16rem);
        margin: auto;
        margin-top: (32/16rem);
        padding-top: (24/16rem);
        border-top: 1px solid #484848;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: (8/16rem);
        text-align: center;
      }

      .cs-copyright,
      .cs-copyright-link {
        font-size: (16/16rem);
        line-height: 1.5em;
        color: #f7f7f7;
        font-family: var(--bodyFont);
      }

      .cs-copyright-link {
        text-decoration: none;
        transition: color 0.3s;
        &:hover {
          color: var(--primary);
        }
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #cs-footer-1110 {
      .cs-container {
        flex-direction: row;
        justify-content: space-between;
        row-gap: (40/16rem);
      }

      .cs-brand {
        width: (320/16rem);
      }

      .cs-nav {
        width: auto;
      }

      .cs-bottom {
        flex-direction: row;
        justify-content: space-between;
        text-align: left;
      }
    }
  }

  /* Small Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #cs-footer-1110 {
      .cs-container {
        max-width: (1440/16rem);
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: nowrap;
        column-gap: clamp(2.5rem, 6vw, 5.25rem);
      }

      .cs-brand {
        width: (360/16rem);
        flex: none;
      }

      .cs-nav {
        flex: none;
      }
    }
  }

  /* Dark Mode — drop the primary-blue base to near-black */
  @media only screen and (min-width: 0rem) {
    body.dark-mode {
      #cs-footer-1110 {
        background:
          linear-gradient(
            -73.74deg,
            rgba(0, 0, 0, 0) 8.97%,
            rgba(0, 0, 0, 0.6) 83.86%
          ),
          #0a0a0a;

        .cs-bottom {
          border-top-color: rgba(255, 255, 255, 0.1);
        }
      }
    }
  }
</style>
