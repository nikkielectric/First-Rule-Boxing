---
// Data
import { BUSINESS } from "@data/client";
---

<section id="sbs-2295">
  <div class="cs-container">
    <div class="cs-content">
      <span class="cs-topper">How It Works</span>
      <h2 class="cs-title">Walk in, meet your coach, start training.</h2>
      <p class="cs-text">
        We've kept it simple on purpose — reach out, come try a class, and
        find the program that fits. No long-term contract required to get
        started, no pressure, no sales pitch.
      </p>
      <h3 class="cs-h3">Getting Started</h3>
      <ul class="cs-ul">
        <li class="cs-li">
          <strong>Reach out</strong>: Call, text, or send a message through
          the contact form and we'll get you on the schedule.
        </li>
        <li class="cs-li">
          <strong>Try a class</strong>: Come meet the coach and see how we
          train. You'll know within one session whether it's a fit.
        </li>
        <li class="cs-li">
          <strong>Pick your program</strong>: Group classes, personal
          training, or youth boxing — whatever matches your
          goals and your schedule.
        </li>
        <li class="cs-li">
          <strong>Keep showing up</strong>: Progress in boxing comes from
          reps. We track where you're at and push you to the next level.
        </li>
      </ul>
      <a href={BUSINESS.bookingUrl} target="_blank" rel="noopener" class="cs-button-solid">Get Started</a>
    </div>
  </div>
</section>

<style lang="less">
  /*-- -------------------------- -->
<---        Side By Side        -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #sbs-2295 {
      padding: var(--sectionPadding);
      background-color: #fff;
      overflow: hidden;
      position: relative;
      z-index: 1;

      .cs-container {
        width: 100%;
        max-width: (704/16rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .cs-content {
        /* set text align to center if content needs to be centrally aligned */
        text-align: left;
        width: 100%;
        max-width: (586/16rem);
        display: flex;
        flex-direction: column;
        /* aligns content to the left, set to center to centrally align */
        align-items: flex-start;
      }

      .cs-title {
        max-width: 30ch;
      }

      .cs-text {
        margin-bottom: (16/16rem);

        &:last-of-type {
          margin-bottom: (24/16rem);
        }
      }

      .cs-h3 {
        font-size: (16/16rem);
        font-weight: 700;
        line-height: 1.5em;
        margin: 0;
        color: var(--headerColor);
      }

      .cs-ul {
        margin: (12/16rem) 0 (32/16rem);
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: (12/16rem);
      }

      .cs-li {
        font-size: (16/16rem);
        line-height: 1.5em;
        list-style: none;
        /* 20px - 24px */
        padding-left: clamp(1.25rem, 3vw, 1.5rem);
        color: var(--bodyTextColor);
        position: relative;

        strong {
          color: #1a1a1a;
        }

        &::before {
          content: "";
          width: (8/16rem);
          height: (8/16rem);
          margin-top: (8/16rem);
          background-color: var(--secondary);
          display: block;
          position: absolute;
          top: 0;
          left: 0;
          transform: rotate(45deg);
        }
      }
    }
  }

  /* Dark Mode */
  @media only screen and (min-width: 0rem) {
    body.dark-mode {
      #sbs-2295 {
        background-color: rgba(0, 0, 0, 0.2);

        .cs-title,
        .cs-text,
        .cs-h3,
        .cs-li {
          color: var(--bodyTextColorWhite);
        }

        .cs-text,
        .cs-li {
          opacity: 0.8;

          strong {
            color: var(--bodyTextColorWhite);
          }
        }
      }
    }
  }
</style>
